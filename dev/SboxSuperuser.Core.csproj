<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code/SboxSuperuser/Core compiled as a plain .NET library. It proves Core has no s&box dependency
       and lets the tests run in seconds without the engine. Not shipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SboxSuperuser.Core</AssemblyName>
    <RootNamespace>SboxSuperuser</RootNamespace>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Code\SboxSuperuser\Assembly.cs" />
    <Compile Include="..\Code\SboxSuperuser\Core\**\*.cs" />
  </ItemGroup>

</Project>
