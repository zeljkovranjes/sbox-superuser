    <Compile Include="../Code/SboxSuperuser/Engine/Permissions/*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Authority/*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Audit/*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Modules/*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/NativeSettings/NativeValue.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/NativeSettings/NativeSettingState.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Moderation/HostModerationService*.cs" />
