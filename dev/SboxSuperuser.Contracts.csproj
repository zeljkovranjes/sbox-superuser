    <Compile Include="examples/**/*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Prefixes/PrefixModule*.cs;../Code/SboxSuperuser/Engine/Prefixes/PrefixHost.cs;../Code/SboxSuperuser/Engine/Admin/PrefixEditorModel.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Admin/HostAdminQueries*.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Admin/AdminRequestGate.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Admin/AdminMenuModel.cs" />
    <Compile Include="../Code/SboxSuperuser/Engine/Admin/AdminServerModel.cs" />
